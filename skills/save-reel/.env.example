# ReelsBrain / save-reel — config. Copie ce fichier en ".env" et remplis.
# .env n'est JAMAIS partagé / affiché dans le chat.

# === Moteur de transcription (reels SANS sous-titres) ===
# Groq Whisper, free tier. Clé : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq pour la distillation headless (peut changer ; voir console.groq.com/docs/models).
# GROQ_DISTILL_MODEL=llama-3.3-70b-versatile
# whisper.cpp 100% local (alternative sans compte) :
# WHISPER_CPP_BIN=/c/tools/whisper.cpp/main.exe
# WHISPER_CPP_MODEL=/c/tools/whisper.cpp/models/ggml-base.bin

# === Reels Instagram gated/privés : cookies de session du navigateur (Chrome FERMÉ) ===
# REELS_BROWSER=chrome

# === Posts 100% IMAGES (carrousels) : OBLIGATOIRE pour lire le texte sur les slides ===
# Instagram gate les images derrière la connexion. Exporte tes cookies instagram.com en
# Netscape cookies.txt (extension "Get cookies.txt LOCALLY") et mets le chemin ici.
# Sans ça, les posts-images partent en file d'attente + alerte Telegram pour re-exporter.
# À ré-exporter quand ça expire (quelques semaines).
# REELS_COOKIES_FILE=C:/Users/<you>/.claude/skills/save-reel/.cookies/instagram.txt

# === Contexte : DESCRIPTION (légende) + AVIS (commentaires) ===
# Récupère la légende du reel/post + les commentaires substantiels (avis), triés par likes.
# 1 = activé (défaut). Mets 0 pour tout couper :
# REELS_FETCH_CONTEXT=1
# Récupérer les commentaires (plus lent) : 1 = oui (défaut), 0 = description seule (rapide) :
# REELS_FETCH_COMMENTS=1
# Nb max d'avis gardés (défaut 12) :
# REELS_MAX_COMMENTS=12

# === Passe VISION (lire le TEXTE à l'écran : reels sans parole, carrousels d'images) ===
# Déclenchée auto quand il y a peu/pas de parole, OU pour un post photo /p/.
# Mets 1 pour TOUJOURS lire le texte à l'écran (même sur les reels qui parlent) :
# REELS_VISION_ALWAYS=0
# Seuil de mots du transcript parlé en dessous duquel on déclenche la vision (défaut 25) :
# REELS_VISION_MIN_WORDS=25
# Nb max de frames distinctes analysées par vidéo (défaut 12) :
# REELS_VISION_MAX_FRAMES=12
# Modèle vision Groq (défaut meta-llama/llama-4-scout-17b-16e-instruct ; Maverick est déprécié) :
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# === Capture Telegram (Phase 2 : le bot Vercel enfile, ce PC draine) ===
# Mêmes valeurs Upstash que ton bot telegram-claude-bot (pour LIRE la file reelsbrain:queue) :
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Token de TON bot existant (pour répondre "✅ Sauvé" sur Telegram) :
TELEGRAM_BOT_TOKEN=

# === Emplacement du vault (optionnel ; défaut ~/Obsidian/ReelsBrain) ===
# REELS_VAULT=C:/Users/<you>/Obsidian/ReelsBrain
